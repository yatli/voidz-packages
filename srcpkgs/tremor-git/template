# Template file for 'tremor-git'
pkgname=tremor-git
version=0.0.1
revision=1
build_style=gnu-configure
hostmakedepends="autoconf automake libtool pkg-config"
makedepends="libogg-devel"
short_desc="Integer-only Vorbis decoder library"
maintainer="Greguu <greguu@null.net>"
license="Custom:Xiph"
homepage="https://wiki.xiph.org/Tremor"
distfiles="https://gitlab.xiph.org/xiph/tremor/-/archive/master/tremor-master.tar.gz"
checksum=6eceff4526bd717c6956b3d49459e13b4cfcfe35781cf09a271790e4ace7315f

#post_extract() {
#	mv ${XBPS_BUILDDIR}/tremor-master ${XBPS_BUILDDIR}/tremor-git-${version}
#}

pre_configure(){
        # Remove broken XIPH_PATH_OGG fallback - pkg-config finds ogg fine
        sed -i '/XIPH_PATH_OGG/,/LIBS=\$libs_save/c\  AC_MSG_ERROR([Ogg not found via pkg-config])' configure.ac
        autoreconf --install
}

tremor-git-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
